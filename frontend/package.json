{
  "name": "go-infra-link-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Static SvelteKit SPA for go_infra_link served by Caddy with same-origin API proxying.",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts --maxWorkers=4",
    "test:watch": "vitest --config vitest.config.ts",
    "api:generate": "node ./scripts/generate-api-contract.mjs",
    "api:check": "pnpm run api:generate && git diff --exit-code -- src/lib/api/generated",
    "api:lint": "prettier --check scripts/generate-api-contract.mjs src/lib/api/generated/permissions.ts src/lib/api/client.ts src/lib/api/client.test.ts src/lib/api/contract.test.ts src/lib/api/users.ts src/lib/components/auth/PermissionGate.svelte src/lib/infrastructure/api/projectRepository.ts src/lib/services/projectCollaboration.svelte.ts src/lib/utils/permissions.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "10.29.1"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.6.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "swagger2openapi": "^7.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.0.11",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2"
    }
  }
}
