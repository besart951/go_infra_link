# ─────────────────────────────────────────────────────────────
#  go_infra_link — PRODUCTION Environment Template
#  Copy:  cp .env.prod.example .env
#  Then fill in every value marked CHANGE_ME before deploying.
# ─────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────
APP_ENV=production
APP_LOG_LEVEL=info             # debug | info | warn | error

# ── Backend Server ───────────────────────────────────────────
BACKEND_PORT=8080
HTTP_ADDR=:8080
SWAGGER_ENABLED=false          # never expose Swagger in production
TRUSTED_PROXIES=CHANGE_ME      # required: reverse proxy IP/CIDR, never 0.0.0.0/0
CORS_ALLOWED_ORIGINS=          # keep empty for same-origin Caddy; if set, use https origins only and never *
APP_PUBLIC_URL=https://CHANGE_ME # public SPA URL used in registration invitation links

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_PORT=80               # host port Caddy SPA listens on (80 or behind reverse proxy)

# ── Database ─────────────────────────────────────────────────
DB_DRIVER=postgres
POSTGRES_SERVICE_HOST=postgres # service name in Docker Compose network
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME    # use a strong random password
POSTGRES_DB=go_infra_link
POSTGRES_CONTAINER_PORT=5432
POSTGRES_SSLMODE=CHANGE_ME     # verify-full/verify-ca/require; use disable only with DB_ALLOW_UNSAFE_SSLMODE=true
DB_ALLOW_UNSAFE_SSLMODE=false  # set true only for an intentionally private DB link, e.g. bundled Compose Postgres
# Must match POSTGRES_SERVICE_HOST / USER / PASSWORD / DB / SSLMODE above
DATABASE_URL=host=postgres user=CHANGE_ME password=CHANGE_ME dbname=go_infra_link port=5432 sslmode=CHANGE_ME

# ── Database Tuning ──────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONNECT_TIMEOUT=5s

# ── Auth / JWT ───────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECURE=true             # must be true in production (HTTPS)
COOKIE_SAME_SITE=strict        # same-origin SPA default
COOKIE_DOMAIN=                 # optional; set only for subdomain sharing, e.g. .yourdomain.com

# ── Seed User (created once on first boot; ignored if user already exists) ──
SEED_USER_ENABLED=true
SEED_USER_FIRST_NAME=Admin
SEED_USER_LAST_NAME=User
SEED_USER_EMAIL=CHANGE_ME@yourdomain.com
SEED_USER_PASSWORD=CHANGE_ME   # must be strong; not "password"
